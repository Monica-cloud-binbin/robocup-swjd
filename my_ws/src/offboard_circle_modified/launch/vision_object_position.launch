<launch>
    <!-- USB camera image source -->
    <include file="$(find usb_cam)/launch/usb_cam-test.launch" />

    <!-- Single-camera YOLO detector -->
    <include file="$(find yolov8_ros)/launch/yolo_v8.launch" />

    <!-- Filter YOLO confidence and publish /object_detection for the main controller. -->
    <node name="my_object_position"
          pkg="my_object_position"
          type="my_object_position"
          output="screen">
        <param name="confidence_threshold" type="double" value="0.8" />
        <param name="image_width" type="int" value="640" />
        <param name="image_height" type="int" value="480" />
    </node>
</launch>
