<launch>
  <arg name="image_topic" default="/d435/color/image_raw" />
  <node pkg="yellow_detector" type="yellow_detector_node.py" name="yellow_detector" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="mission_topic" value="/yellow_balloon_position" />
    <param name="result_topic" value="/yellow_detector/detection" />
    <param name="debug_topic" value="/yellow_detector/debug_image" />

    <!-- OpenCV HSV: H=0..179, S/V=0..255；现场可通过 rosparam 调整。 -->
    <param name="h_min" value="18" />
    <param name="h_max" value="38" />
    <param name="s_min" value="80" />
    <param name="s_max" value="255" />
    <param name="v_min" value="80" />
    <param name="v_max" value="255" />
    <param name="min_area" value="500.0" />
    <param name="morph_kernel_size" value="5" />
  </node>
</launch>
